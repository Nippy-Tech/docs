{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Nippy API Platform",
  "colors": {
    "primary": "#4D9EFF",
    "light": "#4D9EFF",
    "dark": "#378ADD"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "style": "gradient",
    "color": {
      "dark": "#080D14",
      "light": "#F8FAFC"
    }
  },
  "font": {
    "headings": {
      "family": "DM Sans"
    },
    "body": {
      "family": "DM Sans"
    }
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Start here",
            "icon": "house",
            "pages": [
              "index",
              "sdk/quickstart",
              "mcp/quickstart"
            ]
          },
          {
            "group": "SDK",
            "icon": "code",
            "pages": [
              "sdk/introduction",
              "sdk/authentication",
              "sdk/campaigns",
              {
                "group": "Methods",
                "expanded": true,
                "pages": [
                  "sdk/track",
                  "sdk/spin",
                  "sdk/get-state",
                  "sdk/claim"
                ]
              },
              {
                "group": "Webhooks",
                "expanded": false,
                "pages": [
                  "sdk/webhooks",
                  "sdk/webhook-log"
                ]
              },
              {
                "group": "Errors",
                "expanded": false,
                "pages": [
                  "sdk/errors"
                ]
              }
            ]
          },
          {
            "group": "MCP",
            "icon": "plug",
            "pages": [
              "mcp/introduction",
              "mcp/authentication",
              {
                "group": "Tools",
                "expanded": true,
                "pages": [
                  "mcp/analytics",
                  "mcp/roulettes",
                  "mcp/flows",
                  "mcp/learning",
                  "mcp/supply"
                ]
              },
              {
                "group": "Troubleshooting",
                "expanded": false,
                "pages": [
                  "errors"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "API Reference",
            "icon": "book-open",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Resources",
            "icon": "clock",
            "pages": [
              "changelog"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/nippy-light.png",
    "dark": "/logo/nippy-dark.png",
    "href": "https://console.nippy.la"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Console",
      "href": "https://console.nippy.la"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "cursor",
      "mcp"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/nippy_la",
      "linkedin": "https://linkedin.com/company/nippy"
    }
  }
}
