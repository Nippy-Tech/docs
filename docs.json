{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Nippy API Platform",
  "colors": {
    "primary": "#4D9EFF",
    "light": "#4D9EFF",
    "dark": "#378ADD"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "style": "gradient",
    "color": {
      "dark": "#080D14",
      "light": "#F8FAFC"
    }
  },
  "font": {
    "headings": {
      "family": "DM Sans"
    },
    "body": {
      "family": "DM Sans"
    }
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Guías",
        "groups": [
          {
            "group": "Inicio",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Autenticación",
            "pages": [
              "authentication"
            ]
          },
          {
            "group": "Soporte",
            "pages": [
              "errors",
              "changelog"
            ]
          }
        ]
      },
      {
        "tab": "MCP Tools",
        "groups": [
          {
            "group": "Verticales",
            "pages": [
              "mcp/analytics",
              "mcp/supply",
              "mcp/roulettes",
              "mcp/flows",
              "mcp/learning"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API HTTP",
            "pages": [
              "api-reference/introduction"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/nippy-light.png",
    "dark": "/logo/nippy-dark.png",
    "href": "https://console.nippy.la"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Console",
      "href": "https://console.nippy.la"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "cursor",
      "mcp"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/nippy_la",
      "linkedin": "https://linkedin.com/company/nippy"
    }
  }
}
