{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Nippy API Platform",
  "colors": {
    "primary": "#4D9EFF",
    "light": "#4D9EFF",
    "dark": "#378ADD"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "style": "gradient",
    "color": {
      "dark": "#080D14",
      "light": "#F8FAFC"
    }
  },
  "font": {
    "headings": {
      "family": "DM Sans"
    },
    "body": {
      "family": "DM Sans"
    }
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "global": {
      "languages": [
        {
          "language": "es",
          "default": true,
          "href": "/"
        },
        {
          "language": "en",
          "href": "/en"
        }
      ]
    },
    "languages": [
      {
        "language": "es",
        "default": true,
        "hidden": true,
        "tabs": [
          {
            "tab": "Documentación",
            "groups": [
              {
                "group": "Inicio",
                "icon": "house",
                "pages": [
                  "index",
                  "quickstart"
                ]
              },
              {
                "group": "SDK",
                "icon": "code",
                "pages": [
                  "sdk/introduction",
                  "sdk/authentication",
                  "sdk/campaigns",
                  {
                    "group": "Métodos",
                    "expanded": true,
                    "pages": [
                      "sdk/track",
                      "sdk/spin",
                      "sdk/get-state",
                      "sdk/claim"
                    ]
                  },
                  {
                    "group": "Webhooks",
                    "expanded": false,
                    "pages": [
                      "sdk/webhooks",
                      "sdk/webhook-log"
                    ]
                  },
                  {
                    "group": "Errores",
                    "expanded": false,
                    "pages": [
                      "sdk/errors"
                    ]
                  }
                ]
              },
              {
                "group": "MCP",
                "icon": "plug",
                "pages": [
                  "mcp/introduction",
                  "mcp/authentication",
                  {
                    "group": "Tools",
                    "expanded": true,
                    "pages": [
                      "mcp/analytics",
                      "mcp/roulettes",
                      "mcp/flows",
                      "mcp/learning",
                      "mcp/supply"
                    ]
                  },
                  {
                    "group": "Diagnóstico",
                    "expanded": false,
                    "pages": [
                      "errors"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "tab": "Referencia",
            "groups": [
              {
                "group": "API Reference",
                "icon": "book-open",
                "pages": [
                  "api-reference/introduction"
                ]
              },
              {
                "group": "Recursos",
                "icon": "clock",
                "pages": [
                  "changelog"
                ]
              }
            ]
          }
        ]
      },
      {
        "language": "en",
        "hidden": true,
        "tabs": [
          {
            "tab": "Docs",
            "groups": [
              {
                "group": "Start here",
                "icon": "house",
                "pages": [
                  "en/index",
                  "en/quickstart"
                ]
              },
              {
                "group": "SDK",
                "icon": "code",
                "pages": [
                  "en/sdk/introduction",
                  "en/sdk/authentication",
                  "en/sdk/campaigns",
                  {
                    "group": "Methods",
                    "expanded": true,
                    "pages": [
                      "en/sdk/track",
                      "en/sdk/spin",
                      "en/sdk/get-state",
                      "en/sdk/claim"
                    ]
                  },
                  {
                    "group": "Webhooks",
                    "expanded": false,
                    "pages": [
                      "en/sdk/webhooks",
                      "en/sdk/webhook-log"
                    ]
                  },
                  {
                    "group": "Errors",
                    "expanded": false,
                    "pages": [
                      "en/sdk/errors"
                    ]
                  }
                ]
              },
              {
                "group": "MCP",
                "icon": "plug",
                "pages": [
                  "en/mcp/introduction",
                  "en/mcp/authentication",
                  {
                    "group": "Tools",
                    "expanded": true,
                    "pages": [
                      "en/mcp/analytics",
                      "en/mcp/roulettes",
                      "en/mcp/flows",
                      "en/mcp/learning",
                      "en/mcp/supply"
                    ]
                  },
                  {
                    "group": "Troubleshooting",
                    "expanded": false,
                    "pages": [
                      "en/errors"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "tab": "Reference",
            "groups": [
              {
                "group": "Resources",
                "icon": "clock",
                "pages": [
                  "en/changelog"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/nippy-light.png",
    "dark": "/logo/nippy-dark.png",
    "href": "https://console.nippy.la"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Console",
      "href": "https://console.nippy.la"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "cursor",
      "mcp"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/nippy_la",
      "linkedin": "https://linkedin.com/company/nippy"
    }
  }
}
