{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Nippy",
  "colors": {
    "primary": "#6366F1",
    "light": "#818CF8",
    "dark": "#4F46E5"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guías",
        "groups": [
          {
            "group": "Inicio",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Autenticación",
            "pages": [
              "authentication"
            ]
          }
        ]
      },
      {
        "tab": "MCP Tools",
        "groups": [
          {
            "group": "Verticals",
            "pages": [
              "mcp/analytics",
              "mcp/supply",
              "mcp/roulettes",
              "mcp/flows",
              "mcp/learning",
              "mcp/vision"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API HTTP",
            "pages": [
              "api-reference/introduction"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "nippy.la",
          "href": "https://nippy.la",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Soporte",
        "href": "mailto:soporte@nippy.la"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Consola",
      "href": "https://plataforma.nippy.la"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "cursor",
      "mcp"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/nippy_la",
      "linkedin": "https://linkedin.com/company/nippy"
    }
  }
}
